# Database. SQLite for local dev — swap the provider in prisma/schema.prisma
# to "postgresql" and point this at a real Postgres URL when you deploy.
DATABASE_URL="file:./dev.db"

# Gmail OAuth — required to connect a Gmail account and send email from Keiro.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: Web application) and enable the Gmail API for the project.
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL this app is served from. Used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# Company discovery — required for the "Discover companies" search (location +
# sector -> real businesses). Create an API key at
# https://console.cloud.google.com/apis/credentials, enable "Places API (New)"
# for the project, and restrict the key to that API.
GOOGLE_PLACES_API_KEY=
